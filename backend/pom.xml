<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.monstertamers</groupId>
    <artifactId>monster-tamers-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>shared</module>
        <module>simulator</module>
        <module>monster</module>
        <module>encounter</module>
        <module>player</module>
        <module>auth</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-modulith.version>2.1.1</spring-modulith.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.monstertamers</groupId>
                <artifactId>shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.monstertamers</groupId>
                <artifactId>simulator</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.monstertamers</groupId>
                <artifactId>monster</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.monstertamers</groupId>
                <artifactId>encounter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.monstertamers</groupId>
                <artifactId>player</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.monstertamers</groupId>
                <artifactId>auth</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- @ApplicationModule / @NamedInterface in package-info.java -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-api</artifactId>
        </dependency>
    </dependencies>
</project>
