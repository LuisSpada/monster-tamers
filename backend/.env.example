POSTGRES_DB=monster_tamers_auth
POSTGRES_USER=monster_tamers_auth
POSTGRES_PASSWORD=change-me-development-only

PLAYER_POSTGRES_DB=monster_tamers_player
PLAYER_POSTGRES_USER=monster_tamers_player
PLAYER_POSTGRES_PASSWORD=change-me-development-only

MONSTER_POSTGRES_DB=monster_tamers_monster
MONSTER_POSTGRES_USER=monster_tamers_monster
MONSTER_POSTGRES_PASSWORD=change-me-development-only

ENCOUNTER_POSTGRES_DB=monster_tamers_encounter
ENCOUNTER_POSTGRES_USER=monster_tamers_encounter
ENCOUNTER_POSTGRES_PASSWORD=change-me-development-only

JWT_SECRET=change-me-development-only-jwt-secret
SPRING_PROFILES_ACTIVE=local

# Mail delivery mode:
# - logging: writes the confirmation code to Auth Service logs
# - smtp: sends the confirmation code through an SMTP provider
MAIL_MODE=logging

# Required only when MAIL_MODE=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# SMTP transport settings
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000
